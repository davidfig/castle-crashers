{
  "name": "game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:server": "pnpm --dir ../server-geometry dev",
    "kill": "pkill -f \"node tools/[d]ev.mjs\" && echo \"dev servers stopped\" || echo \"no dev servers running\"",
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tools/test.mjs",
    "check": "node tools/check-sim.mjs",
    "playtest": "node tools/playtest.mjs",
    "sim": "node tools/sim.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "server-geometry-client": "link:../server-geometry/client"
  }
}
